# Copy to .env for local work; set these as environment variables on Render.
# Never commit the real .env — it is gitignored.

# --- Database (Turso) -------------------------------------------------------
# Leave both blank locally to use a SQLite file at ./data/local.db instead.
# On Render these are REQUIRED: the free filesystem is ephemeral, so a file
# database is wiped on every deploy.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Secrets ----------------------------------------------------------------
# Signs the browser's session cookie. Any long random string.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Proves a request came from the real Catcher Device. The same value is entered
# once into the device through its WiFi setup portal.
DEVICE_KEY=

# --- Server -----------------------------------------------------------------
# Render sets PORT itself; only needed locally.
PORT=3000

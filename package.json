{
  "name": "arduinomyhealth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ArduinoMyHealth \u2014 API and dashboard for the Catcher Device",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "build": "npm install --prefix web && npm run build --prefix web"
  },
  "dependencies": {
    "@libsql/client": "^0.15.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "jsonwebtoken": "^9.0.2"
  }
}
